# Docker deployment: PUBLIC_HOST must be reachable from the browser.
# Use only an IP address or hostname, without a scheme or port.
PUBLIC_HOST=localhost
BACKEND_PORT=8010
FRONTEND_PORT=3030
MEDCAT_PORT=5000

# Select openai or gemini and fill in the selected provider's key.
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides; these values match the application's defaults.
OPENAI_MODEL=gpt-4
GEMINI_MODEL=models/gemini-2.0-flash

# Optional NCBI key. Leave empty for unauthenticated E-utilities access.
NCBI_API_KEY=

# Used when running FastAPI outside Docker; match MEDCAT_PORT if changed.
# Compose overrides this with the internal medcat-service address.
MEDCAT_URL=http://localhost:5000/api/process

